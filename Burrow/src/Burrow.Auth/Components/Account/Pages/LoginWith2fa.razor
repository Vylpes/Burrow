@page "/Account/LoginWith2fa"

<PageTitle>Two-factor authentication</PageTitle>

<div class="container mt-4 d-flex justify-content-center">
    <div class="card" style="min-width: 520px; width: 100%; max-width: 540px;">
        <div class="card-header">Two-factor authentication</div>
        <div class="card-body">
            <StatusMessage Message="@message" />
            <p>Your login is protected with an authenticator app. Enter your authenticator code below.</p>
            <EditForm Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post">
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                <input type="hidden" name="RememberMe" value="@RememberMe" />
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="two-factor-code" class="form-label">Authenticator code</label>
                    <InputText @bind-Value="Input.TwoFactorCode" id="two-factor-code" class="form-control" autocomplete="off" />
                    <ValidationMessage For="() => Input.TwoFactorCode" class="text-danger" />
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox @bind-Value="Input.RememberMachine" id="remember-machine" class="form-check-input" />
                    <label for="remember-machine" class="form-check-label">Remember this machine</label>
                </div>
                <button type="submit" class="w-100 btn btn-primary">Log in</button>
            </EditForm>
            <div class="mt-3">
                <a href="Account/LoginWithRecoveryCode?ReturnUrl=@ReturnUrl" class="text-muted small">Don't have access to your authenticator? Use a recovery code.</a>
            </div>
        </div>
    </div>
</div>
