@page "/Account/ForgotPassword"

<PageTitle>Forgot your password?</PageTitle>

<div class="container mt-4 d-flex justify-content-center">
    <div class="card" style="min-width: 520px; width: 100%; max-width: 540px;">
        <div class="card-header">Forgot Password</div>
        <div class="card-body">
            <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <InputText @bind-Value="Input.Email" id="email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>
                <button type="submit" class="w-100 btn btn-primary">Reset password</button>
            </EditForm>
        </div>
    </div>
</div>
