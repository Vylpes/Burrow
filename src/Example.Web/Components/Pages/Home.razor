@page "/"

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container mt-4">
            <h1 class="fw-bold">Dashboard</h1>
            <p class="text-muted">Logged in as @context.User.Identity?.Name</p>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container mt-4">
            <div class="card">
                <div class="card-header">In Development</div>
                <div class="card-body">
                    <h2 class="card-title mb-3">This site is currently in development.</h2>
                    <ul>
                        <li>Features will be incomplete</li>
                        <li>Features will be buggy</li>
                    </ul>
                    <div class="mt-3">
                        <a href="#" class="btn btn-primary me-2">View GitHub</a>
                        <a href="#" class="btn btn-outline-primary me-2">Report a Bug</a>
                        <a href="#" class="btn btn-outline-primary">Join Discord</a>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

