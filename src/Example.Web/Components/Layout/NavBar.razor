@using Microsoft.AspNetCore.Components.Authorization

<nav class="navbar navbar-expand bg-white border-bottom py-2">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-dark" href="/">Example</a>
        <AuthorizeView>
            <Authorized>
                <div class="navbar-nav">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
                </div>
                <div class="navbar-nav ms-auto align-items-center">
                    <form action="Account/Logout" method="post" class="d-inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/" />
                        <button type="submit" class="btn btn-link nav-link">Logout</button>
                    </form>
                    <a class="nav-link" href="/Account/Manage"><i class="bi bi-gear"></i></a>
                    <span class="navbar-text ms-1">Logged in as @context.User.Identity?.Name</span>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="navbar-nav">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home</NavLink>
                </div>
                <div class="navbar-nav ms-auto">
                    <NavLink class="nav-link" href="/Account/Login">Login</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>
